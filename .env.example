# --- Required for the real thing (leave blank to run in no-key "echo" mode) ---
GEMINI_API_KEY=

# --- Models (change here if Google renames/retires them) ---
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.8-flash
# Brain: "gemini" or "echo" (echo = parrots your voice back through the FX; no API calls)
BRAIN=gemini

# --- Voice ---
# Try deep/rough voices in AI Studio's Live playground first. Charon is a safe default.
VOICE=Charon
CHARACTER_NAME=Old Bones
CANDY_RULE=If it comes up naturally, remind them to take ONE piece of candy from the bowl.

# --- Persona mode ---
# auto = family-friendly until SCARY_START, scary until SCARY_END (24h local time).
# family / scary = always that mode.
# Instant override without restarting:  echo scary > mode.txt   (or family / auto; rm mode.txt to clear)
PERSONA_MODE=auto
SCARY_START=20:30
SCARY_END=05:00
# Testing only: pretend it's this time of day (same as --pretend-time). Leave blank normally.
PRETEND_TIME=
# Optional scary-mode voice/FX (blank = same as above). Regenerate greetings after changing the voice:
#   python -m skeleton.greetings --mode scary
SCARY_VOICE=
SCARY_FX_PITCH_SEMITONES=
SCARY_FX_REVERB=
SCARY_FX_DRIVE_DB=

# --- Voice effects (pedalboard). Tune with: python -m skeleton.fx_preview greetings/family/greet_01.wav ---
FX_ENABLED=true
FX_PITCH_SEMITONES=-4
FX_DRIVE_DB=0
FX_REVERB=0.3
FX_GAIN_DB=0

# --- Conversation behavior ---
MAX_CONVERSATION_S=90
MAX_TURNS=6
SILENCE_TIMEOUT_S=8
COOLDOWN_S=10
VAD_SILENCE_MS=700

# --- Body device (separate radar/LED/jaw board) ---
# Extra delay before sending mouth levels to the body so the jaw lines up with
# the voice coming out of the audio device. Tune by eye: raise if the jaw moves
# before the sound, lower if it lags.
MOUTH_DELAY_MS=120

# --- Vision (costume description) ---
# Off by default: on the original build the ESP32 camera never produced a usable costume
# description on Halloween night (see the README's "Lessons" section), so it only cost API calls.
# true = take VISION_FRAMES photos per visitor and tell the model about the costumes.
VISION_ENABLED=false
VISION_FRAMES=3
VISION_INTERVAL_MS=500
VISION_GRACE_S=1.0
# Wait this long after the radar trigger before taking photos, so the visitor
# has stepped into the camera's view.
VISION_DELAY_S=1.5

# --- Saving camera frames (privacy!) ---
# Frames are of your visitors, often children. By default they are only kept in memory
# (sent to the vision model and shown as the last 8 in the admin UI) and never written to disk.
# Set PHOTOS_KEEP to N > 0 to save the newest N frames to PHOTOS_DIR for debugging.
PHOTOS_KEEP=0
# PHOTOS_DIR=photos          # /data/photos in Docker

# --- Server ---
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO

# --- Random phrases (admin UI toggle; always off after a restart) ---
# Seconds between phrases while the mode is on. Phrases live in greetings/<mode>/phrases/lines.txt.
CHATTER_INTERVAL_S=30

# --- Camera ---
# 1 = the body camera is mounted upside down: frames are rotated 180 degrees
# on arrival, before they are saved, sent to the model or shown in the admin UI.
CAMERA_ROTATE_180=0

# --- Device WebSocket auth ---
# Shared secret the body/audio boards (and sim_client) must send as
# "Authorization: Bearer <token>". Connections without it get HTTP 401.
# Blank = no auth (LAN only!). Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# --- Admin UI (phone-friendly settings page) ---
ADMIN_PORT=8080
# The admin UI has NO login of its own. Never expose port 8080 to the internet without
# putting authentication in front of it (see docs/DEPLOY.md, Traefik basic auth).
# Where the admin UI's live overrides (voice/FX/timing) are stored. Like
# mode.txt, this beats the values above and applies to the next conversation.
# (Docker sets this to /data/settings.json; leave it commented out there.)
# SETTINGS_FILE=settings.json

# --- Background audio (admin UI turns it on; always off after a restart) ---
# mp3s live in AMBIENT_DIR (data/ambient/ next to docker-compose.yml when using Docker). No music
# ships with this repo: drop in your own royalty-free mp3 and pick it in the admin UI (or name it here).
# Volume is 0..1 and affects only the music, not the skeleton voice.
AMBIENT_FILE=haunted.mp3
AMBIENT_VOLUME=0.5
